# Local Docker Compose credentials. Use only URL-safe characters here.
POSTGRES_PASSWORD=smm-local-only
SMM_API_PORT=8180
COLLECT_INTERVAL=2m
WORKER_TICK_INTERVAL=5s
TELEGRAM_BOT_TOKEN=
# Generate separate random keys before starting Compose.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=news-media
SMM_MEDIA_DIR=D:/smm-agent-media
# Optional Chat Completions endpoint for generating channel filters
LLM_FILTERS_URL=
LLM_FILTERS_MODEL=
LLM_FILTERS_API_KEY=
# Optional inference endpoints used for borderline topic decisions
TOPIC_EMBEDDINGS_URL=
TOPIC_EMBEDDINGS_MODEL=
TOPIC_EMBEDDINGS_API_KEY=
TOPIC_LLM_URL=
TOPIC_LLM_MODEL=
TOPIC_LLM_API_KEY=
SMM_LLM_DIR=D:/smm-agent-models
EVENT_CATALOG_SHADOW=0
